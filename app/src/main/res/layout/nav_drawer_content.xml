<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation drawer, matching ntfy-web SidebarBrand + SidebarContent. Rows are wired in MainActivity. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/drawer_tile_bg"
            android:backgroundTint="@color/accent_ui">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_bell"
                android:importantForAccessibility="no"
                app:tint="@color/accent_on_surface" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/brand_name"
            android:textColor="@color/text"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <include
        android:id="@+id/drawer_item_all"
        layout="@layout/drawer_item_row" />

    <include
        android:id="@+id/drawer_item_history"
        layout="@layout/drawer_item_row" />

    <!-- Topics header with subscribe "+" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sidebar_topics_title"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <ImageButton
            android:id="@+id/drawer_add_topic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_drawer_subscribe"
            app:tint="@color/muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/drawer_no_topics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:padding="12dp"
        android:background="@drawable/drawer_empty_bg"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="@string/sidebar_no_topics"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_body_sm"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer_subscriptions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        app:layoutManager="LinearLayoutManager" />

    <include
        android:id="@+id/drawer_item_settings"
        layout="@layout/drawer_item_row" />

    <View
        android:id="@+id/drawer_bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="12dp" />

</LinearLayout>
