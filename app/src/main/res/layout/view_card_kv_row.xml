<?xml version="1.0" encoding="utf-8"?>
<!-- KV row, ntfy-web StructuredCard KvRow (narrow layout):
     [32dp icon tile] [key (caption, muted) above value (body-sm medium, or code chip for paths) + status dot / meter].
     Dividers between rows are added by KvBlockRenderer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_3"
    android:paddingBottom="@dimen/spacing_3">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/drawer_tile_bg"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/kv_row_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/kv_row_icon_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/kv_status_dot"
            android:backgroundTint="@color/muted"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_3"
        android:paddingTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kv_row_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_sans"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/muted"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/kv_row_status_dot"
                android:layout_width="@dimen/kv_status_dot_size"
                android:layout_height="@dimen/kv_status_dot_size"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/kv_status_dot"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/kv_row_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/font_sans"
                android:textSize="@dimen/text_body_sm"
                android:lineSpacingMultiplier="1.15"
                android:textFontWeight="500"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text" />

            <io.heckel.ntfy.ui.structured.InlineMeterView
                android:id="@+id/kv_row_meter"
                android:layout_width="80dp"
                android:layout_height="@dimen/meter_track_height"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
