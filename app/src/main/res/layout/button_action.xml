<?xml version="1.0" encoding="utf-8"?>
<!-- Card action button, ntfy-web Button size="sm": 32dp tall, 12dp padding, caption semibold, radius_sm.
     First action is primary (blue fill), the rest ghost (surface-2); colours set in MessageCardBinder. -->
<com.google.android.material.button.MaterialButton
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:id="@+id/button"
        android:text="Button"
        android:layout_margin="0dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetBottom="0dp"
        android:insetTop="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:fontFamily="@font/font_sans"
        android:textFontWeight="600"
        android:textStyle="bold"
        android:textSize="@dimen/text_caption"
        app:backgroundTint="@color/button_fill"
        android:textColor="@color/button_fill_text"
        app:cornerRadius="@dimen/radius_sm" />
