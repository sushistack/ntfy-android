<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer topic row (ntfy-web Sidebar): coloured initial avatar, name, muted icon, unread pill, ⋯ menu. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="2dp"
    android:paddingVertical="6dp"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/drawer_item_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textSize="@dimen/text_body_sm"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        tools:text="C" />

    <TextView
        android:id="@+id/drawer_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="My Topic Name" />

    <ImageView
        android:id="@+id/drawer_item_muted"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_nav_bell_off"
        android:contentDescription="@string/drawer_sub_muted_content_description"
        app:tint="@color/muted"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/drawer_item_unread"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:minWidth="18dp"
        android:paddingHorizontal="6dp"
        android:gravity="center"
        android:background="@drawable/drawer_badge_bg"
        android:textColor="@color/accent_on_surface"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:visibility="gone"
        tools:text="12"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/drawer_item_overflow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_dots"
        android:background="?attr/actionBarItemBackground"
        android:contentDescription="@string/drawer_sub_overflow_content_description"
        app:tint="@color/muted" />

</LinearLayout>
