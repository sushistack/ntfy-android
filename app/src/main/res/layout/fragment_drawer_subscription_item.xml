<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="48dp"
    android:paddingStart="0dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Active bar: 4dp wide × 16dp tall pill, colored accent_ui (active) or transparent (inactive) -->
    <View
        android:id="@+id/drawer_item_active_bar"
        android:layout_width="4dp"
        android:layout_height="16dp"
        android:background="@drawable/drawer_active_bar_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:backgroundTint="@color/accent_ui" />

    <!-- Left icon: chat bubble 20×20dp -->
    <ImageView
        android:id="@+id/drawer_item_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chat_bubble_24dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toEndOf="@id/drawer_item_active_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:tint="@color/accent_ui" />

    <!-- ⋯ overflow button: anchored end -->
    <ImageButton
        android:id="@+id/drawer_item_overflow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="0dp"
        android:src="@drawable/ic_more_vert_24dp"
        android:background="?attr/actionBarItemBackground"
        android:contentDescription="@string/drawer_sub_overflow_content_description"
        app:tint="@color/muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Muted indicator: bell-off icon, just left of overflow button -->
    <ImageView
        android:id="@+id/drawer_item_muted"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_notifications_off_gray_outline_24dp"
        android:contentDescription="@string/drawer_sub_muted_content_description"
        android:importantForAccessibility="yes"
        android:clickable="false"
        android:focusable="false"
        app:tint="@color/muted"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/drawer_item_overflow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible" />

    <!-- Unread count: caption style, accent_ui, right-aligned, gone when 0 -->
    <TextView
        android:id="@+id/drawer_item_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textAppearance="@style/TextAppearance.Ntfy.Caption"
        android:textColor="@color/accent_ui"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/drawer_item_muted"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="12"
        tools:visibility="visible" />

    <!-- Name: body_sm text, primary text color, single line with ellipsis -->
    <TextView
        android:id="@+id/drawer_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:textAppearance="@style/TextAppearance.Ntfy.BodySmall"
        android:textColor="@color/text"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/drawer_item_icon"
        app:layout_constraintEnd_toStartOf="@id/drawer_item_unread"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="My Topic Name" />

</androidx.constraintlayout.widget.ConstraintLayout>
