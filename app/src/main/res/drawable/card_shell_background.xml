<?xml version="1.0" encoding="utf-8"?>
<!-- Squared card shell background: @color/surface fill + 1dp @color/border stroke, zero radius -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item
        android:left="@dimen/card_border_width"
        android:top="@dimen/card_border_width"
        android:right="@dimen/card_border_width"
        android:bottom="@dimen/card_border_width">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
