  "meterCases": [
    { "id": "meter-boundary-64",  "input": { "value": 64.0 }, "expected": "ok" },
    { "id": "meter-boundary-65",  "input": { "value": 65.0 }, "expected": "warning" },
    { "id": "meter-boundary-89",  "input": { "value": 89.0 }, "expected": "warning" },
    { "id": "meter-boundary-90",  "input": { "value": 90.0 }, "expected": "critical" },
    { "id": "meter-boundary-91",  "input": { "value": 91.0 }, "expected": "critical" },

    { "id": "meter-low-zero",     "input": { "value": 0.0 },  "expected": "ok" },
    { "id": "meter-low-10",       "input": { "value": 10.0 }, "expected": "ok" },
    { "id": "meter-mid-50",       "input": { "value": 50.0 }, "expected": "ok" },
    { "id": "meter-warn-70",      "input": { "value": 70.0 }, "expected": "warning" },
    { "id": "meter-warn-80",      "input": { "value": 80.0 }, "expected": "warning" },
    { "id": "meter-crit-95",      "input": { "value": 95.0 }, "expected": "critical" },
    { "id": "meter-crit-100",     "input": { "value": 100.0 },"expected": "critical" }
